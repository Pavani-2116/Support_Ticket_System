{
  "info": {
    "name": "Support Ticket System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "item": [
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\":\"Test User\",\"email\":\"newuser@example.com\",\"password\":\"password123\"}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login (success)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"agent@example.com\",\"password\":\"password123\"}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login (invalid password)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"agent@example.com\",\"password\":\"wrong\"}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create ticket (customer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"subject\":\"Test\",\"description\":\"Desc\",\"priority\":\"low\"}" },
        "url": "{{baseUrl}}/tickets"
      }
    },
    {
      "name": "Get tickets",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/tickets"
      }
    },
    {
      "name": "Get ticket by ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Update ticket (agent)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"in_progress\"}" },
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Unauthorized request (no token)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tickets"
      }
    },
    {
      "name": "Forbidden (customer hits agent-only update)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"closed\"}" },
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Invalid input (missing subject)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"description\":\"no subject given\"}" },
        "url": "{{baseUrl}}/tickets"
      }
    },
    {
      "name": "Not found ticket",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/tickets/999999"
      }
    }
  ]
}
