{
  "info": {
    "name": "Support Ticket Management System",
    "_postman_id": "a7c2e1d0-4b8f-4c21-9d55-support-ticket",
    "description": "API tests for registration, login, tickets, authorization and validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3002" },
    { "key": "customerToken", "value": "" },
    { "key": "agentToken", "value": "" },
    { "key": "ticketId", "value": "1" },
    { "key": "customerEmail", "value": "postman.customer@example.com" }
  ],
  "item": [
    {
      "name": "Successful registration",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Successful customer login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('customerToken', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Successful agent login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('agentToken', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Invalid login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"wrong-password\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Create ticket",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.ticketId) pm.collectionVariables.set('ticketId', String(json.ticketId));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Cannot print invoices\",\n  \"description\": \"The printer tray is jammed and jobs stay queued.\",\n  \"priority\": \"high\"\n}"
        },
        "url": "{{baseUrl}}/api/tickets"
      }
    },
    {
      "name": "Get tickets",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": "{{baseUrl}}/api/tickets"
      }
    },
    {
      "name": "Get ticket by ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Update ticket",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{agentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\",\n  \"priority\": \"high\"\n}"
        },
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Unauthorized API request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tickets"
      }
    },
    {
      "name": "Forbidden request for incorrect role",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"closed\"\n}"
        },
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Invalid input",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{customerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"\",\n  \"description\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/tickets"
      }
    },
    {
      "name": "Not-found ticket",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
        "url": "{{baseUrl}}/api/tickets/999999"
      }
    }
  ]
}
